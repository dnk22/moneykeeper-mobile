ENV['RCT_NEW_ARCH_ENABLED'] = '1'

def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
     "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '15.1' # Đảm bảo min iOS phù hợp với RN 0.83
prepare_react_native_project!

# 1. Cấu hình Firebase Static Framework
$RNFirebaseAsStaticFramework = true
use_modular_headers!

setup_permissions([
  'Camera', 'Contacts', 'FaceID', 'Notifications', 'PhotoLibrary', 'PhotoLibraryAddOnly', 'Reminders',
])

target 'moneykeeper' do
  config = use_native_modules!

  # 2. Quan trọng cho Swift & Firebase
  use_frameworks! :linkage => :static

  # 3. Cấu hình React Native với New Arch
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true,
    :fabric_enabled => true # Bật để sửa lỗi "No such module 'ReactAppDependencyProvider'"
  )

  # 4. Các thư viện đặc thù không autolink hoàn toàn hoặc cần config riêng
  pod 'simdjson', path: '../node_modules/@nozbe/simdjson'
  
  # Firebase Pods (Nếu autolink không hoạt động, bạn giữ lại, nhưng thường RN 0.83 sẽ tự nhận)
  # pod 'RNFBAuth', :path => '../node_modules/@react-native-firebase/auth'
  # pod 'RNFBDatabase', :path => '../node_modules/@react-native-firebase/database'

  post_install do |installer|
    # 5. Đảm bảo config hệ thống của React Native được thực thi
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # Fix lỗi build "Double quoted include" thường gặp khi dùng Swift + Static Frameworks
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end