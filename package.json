{
  "name": "moneykeeper",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator 'iPhone 16 Pro'",
    "pod": "cd ios && rm -rf Pods Podfile.lock && bundle exec pod install",
    "pod-update": "cd ios && bundle exec pod install --repo-update",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "list-devices": "xcrun xctrace list devices",
    "npm-check": "npx npm-check -u",
    "gen-images": "node updateImagesPath.js",
    "gen-svg": "node updateSvgPath.js",
    "clean": "react-native-clean-project",
    "bundle-android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle-ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle:analysis": "visualize-bundle",
    "clean:ios": "rm -rf ios/Pods ios/Podfile.lock ios/build && xcodebuild clean -workspace ios/moneykeeper.xcworkspace -scheme moneykeeper && rm -rf ~/Library/Developer/Xcode/DerivedData/moneykeeper-*",
    "clean:build": "rm -rf android/app/build ios/build",
    "nuke": "yarn clean && yarn clean:ios && rm -rf node_modules && yarn install && cd ios && yarn pod"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@hookform/resolvers": "^5.2.2",
    "@lodev09/react-native-true-sheet": "^3.7.0",
