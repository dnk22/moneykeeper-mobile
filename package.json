{
  "name": "moneykeeper",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pod": "cd ios && pod install",
    "pod-update": "cd ios && pod install --repo-update",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "lint": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "list-devices": "xcrun xctrace list devices",
    "npm-check": "npx npm-check -u",
    "gen-images": "node updateImagesPath.js",
    "gen-svg": "node updateSvgPath.js",
    "clean": "react-native-clean-project",
    "bundle-android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle-ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle:analysis": "visualize-bundle"
  },
  "dependencies": {
