{
  "name": "moneykeeper",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pod": "cd ios && pod install",
    "podV": "cd ios && pod install --verbose",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "lint": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "list-devices": "xcrun xctrace list devices",
    "npm-check": "npx npm-check -u",
    "gen-images": "node updateImagesPath.js",
    "gen-svg": "node updateSvgPath.js",
    "clean": "react-native-clean-project",
    "bundle-android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && react-native-bundle-analyzer android/app/src/main/assets/index.android.bundle",
    "bundle-ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios && react-native-bundle-analyzer ios/main.jsbundle"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4.6.1",
    "@notifee/react-native": "^7.8.2",
    "@nozbe/watermelondb": "^0.27.1",
    "@react-native-community/blur": "^4.4.0",
    "@react-native-community/datetimepicker": "^8.0.0",
    "@react-native-menu/menu": "^0.9.1",
    "@react-native-picker/picker": "^2.7.5",
    "@react-native-segmented-control/segmented-control": "^2.5.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/material-top-tabs": "^6.6.13",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@reduxjs/toolkit": "^2.1.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "i18next": "^23.2.3",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-fast-compare": "^3.2.2",
    "react-hook-form": "^7.51.4",
    "react-i18next": "^13.0.1",
    "react-native": "^0.74.1",
    "react-native-collapsible": "^1.6.1",
    "react-native-color-picker-ios": "^0.1.2",
    "react-native-contacts": "^7.0.8",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-gifted-charts": "^1.4.7",
    "react-native-haptic-feedback": "^2.0.3",
    "react-native-ios-context-menu": "^1.15.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
